import io
import pandas as pd

csv_data = """day,customers,revenue
Mon,120,3500
Tue,135,3900
Wed,110,3000
Thu,150,4200"""

df_sales = pd.read_csv(io.StringIO(csv_data))
print("--початковий DataFrame--")
print(df_sales)

df_sales_sorted = df_sales.sort_values(by="revenue", ascending=False)

print("\n--відсортований DataFrame--")
print(df_sales_sorted)

df_sales_sorted.to_csv("sales_sorted.csv", index=False)
print("\nрезультат успішно збережено у 'sales_sorted.csv'")
